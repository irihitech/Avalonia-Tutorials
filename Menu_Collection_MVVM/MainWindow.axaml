<Window
    x:Class="Menu_Collection_MVVM.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Menu_Collection_MVVM"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Menu Collection MVVM"
    Width="600"
    Height="400"
    x:CompileBindings="True"
    x:DataType="local:MainViewModel"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <DockPanel>
        <!-- This is a sample of generating entire menu with MVVM -->
        <Menu DockPanel.Dock="Top" ItemsSource="{Binding MenuItems}">
            <Menu.Styles>
                <Style Selector="MenuItem" x:DataType="local:MenuItemViewModel">
                    <!-- below line is needed to generate separator from dash. You can remove it if you don't need to -->
                    <Setter Property="Header" Value="{Binding MenuHeader}" />
                    <Setter Property="Command" Value="{Binding MenuCommand}" />
                </Style>
            </Menu.Styles>
            <Menu.ItemTemplate>
                <TreeDataTemplate x:DataType="local:MenuItemViewModel" ItemsSource="{Binding SubItems}">
                    <TextBlock Text="{Binding MenuHeader}" />
                </TreeDataTemplate>
            </Menu.ItemTemplate>
        </Menu>
        <!-- this is a sample of partially generating menu with MVVM -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Fixed Menu Item1" >
                <MenuItem Header="Fixed SubMenu Item1" />
            </MenuItem>
            <MenuItem Header="Fixed Menu Item2" >
                <MenuItem Header="Fixed SubMenu Item2" />
            </MenuItem>
            <MenuItem Header="Fixed Menu Item3" ItemsSource="{Binding MenuItems}" >
                <MenuItem.Styles>
                    <Style Selector="MenuItem" x:DataType="local:MenuItemViewModel">
                        <!-- below line is needed to generate separator from dash. You can remove it if you don't need to -->
                        <Setter Property="Header" Value="{Binding MenuHeader}" />
                        <Setter Property="Command" Value="{Binding MenuCommand}" />
                    </Style>
                </MenuItem.Styles>
                <MenuItem.ItemTemplate>
                    <TreeDataTemplate x:DataType="local:MenuItemViewModel" ItemsSource="{Binding SubItems}">
                        <TextBlock Text="{Binding MenuHeader}" />
                    </TreeDataTemplate>
                </MenuItem.ItemTemplate>
            </MenuItem>
        </Menu>
        <TextBlock
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="16"
            Text="{Binding LastAction}" />
    </DockPanel>
</Window>
