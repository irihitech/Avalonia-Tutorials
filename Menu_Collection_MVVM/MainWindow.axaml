<Window
    x:Class="Menu_Collection_MVVM.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Menu_Collection_MVVM"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Menu Collection MVVM"
    Width="600"
    Height="400"
    x:CompileBindings="True"
    x:DataType="local:MainViewModel"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <DockPanel>
        <Menu DockPanel.Dock="Top" ItemsSource="{Binding MenuItems}">
            <Menu.ItemContainerTheme>
                <ControlTheme x:DataType="local:MenuItemViewModel" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                    <Setter Property="Header" Value="{Binding Header}" />
                    <Setter Property="ItemsSource" Value="{Binding SubItems}" />
                    <Setter Property="Command" Value="{Binding Command}" />
                </ControlTheme>
            </Menu.ItemContainerTheme>
        </Menu>
        <TextBlock
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="16"
            Text="{Binding LastAction}" />
    </DockPanel>
</Window>
